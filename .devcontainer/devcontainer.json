{
  "name": "Graftwork Stock",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // mise installs the toolchain from mise.toml, so the container and the
    // local fast path resolve to identical pinned versions.
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  // The mise feature installs the binary but does not activate it. Putting
  // its shims on PATH makes python, uv and node resolve to the pinned
  // versions in every shell, including postCreateCommand. ~/.local/bin is
  // where Claude Code's native installer puts `claude`.
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "postCreateCommand": "mise trust && mise install && uv sync && curl -fsSL https://claude.ai/install.sh | bash",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "charliermarsh.ruff", "ms-python.python"]
    }
  }
}
